# 9. ملف GitHub Actions (البناء التلقائي)
cat > $PROJECT_DIR/.github/workflows/build.yml << 'EOF'
name: Build APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Build with Gradle
        run: |
          chmod +x gradlew
          ./gradlew assembleRelease
        shell: bash

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release
          path: app/build/outputs/apk/release/*.apk
EOF

echo "✅ تم إنشاء المجلد $PROJECT_DIR بنجاح على سطح المكتب!"
echo "📂 ارفع هذا المجلد كاملاً إلى GitHub (رابط الإنشاء في الشرح أدناه)."
